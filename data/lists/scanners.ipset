# ScannersDB 2026-10-31: 124 records, 27063 IPv4 and 5703 IPv6 networks. https://github.com/cyberanchor/ScannersDB
# Load (again to update): ipset restore -exist < scanners.ipset, then once for example
#   iptables -I INPUT -m set --match-set scannersdb_v4 src -j DROP
#   ip6tables -I INPUT -m set --match-set scannersdb_v6 src -j DROP
# The new entries go into a temporary set that is swapped in, so the set is never empty while loading.
create scannersdb_v4 hash:net family inet hashsize 16384 maxelem 262144
create scannersdb_v4_new hash:net family inet hashsize 16384 maxelem 262144
flush scannersdb_v4_new
